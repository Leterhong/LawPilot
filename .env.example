# =============================================================
# LawPilot 环境变量模板
# 复制本文件为 .env 并填写真实值：cp .env.example .env
# 所有变量均有默认值（仅用于本地开发），生产环境必须覆盖。
# =============================================================

# -------------------------------
# 服务通用
# -------------------------------
ENVIRONMENT=development            # development | production
PROJECT_NAME=LawPilot
API_V1_PREFIX=/api/v1

# -------------------------------
# PostgreSQL（含 pgvector）
# -------------------------------
POSTGRES_USER=lawpilot
POSTGRES_PASSWORD=lawpilot_secret
POSTGRES_DB=lawpilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
# 后端连接串（容器内使用 db，本地开发可改为 localhost）
DATABASE_URL=postgresql+asyncpg://lawpilot:lawpilot_secret@db:5432/lawpilot

# -------------------------------
# Redis
# -------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# -------------------------------
# 后端服务
# -------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
# 允许的前端来源（逗号分隔）。生产环境禁止使用 *（与 allow_credentials 冲突）
CORS_ORIGINS=http://localhost:3000,http://localhost

# 是否暴露 /docs、/redoc、/openapi.json
# 留空 = 自动策略（非生产开启、生产关闭）
# 生产如需保留文档，填 true，但务必在 Nginx 层加 IP 白名单
# EXPOSE_DOCS=true

# -------------------------------
# 安全 / 认证（JWT）
# -------------------------------
# 生产环境务必使用强随机值：openssl rand -hex 32
SECRET_KEY=dev_secret_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
JWT_ISSUER=lawpilot
JWT_AUDIENCE=lawpilot-client

# -------------------------------
# 大模型（OpenAI Compatible）
# -------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# 用于 Agent 的推理模型（可不同于对话模型）
LLM_REASONING_MODEL=gpt-4o

# -------------------------------
# Embedding（BGE-M3）
# -------------------------------
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# -------------------------------
# Rerank（可选，留空则使用规则重排）
# -------------------------------
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# -------------------------------
# 向量检索
# -------------------------------
VECTOR_SIMILARITY_TOP_K=20      # 向量召回数量
KEYWORD_TOP_K=20                 # 关键词召回数量
RERANK_TOP_K=8                   # 重排后保留数量

# -------------------------------
# 文件上传
# -------------------------------
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.png,.jpg,.jpeg

# -------------------------------
# 前端
# -------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=LawPilot
